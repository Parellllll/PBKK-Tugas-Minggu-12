CI_ENVIRONMENT = development
app.baseURL = ''
app.indexPage = ''

# Database default: SQLite3 (tersimpan di writable/shopease_crud.db)
database.default.database = shopease_crud.db
database.default.DBDriver = SQLite3
database.default.foreignKeys = true

# Untuk menggunakan MySQL (db_shopease), komentar 3 baris SQLite di atas lalu aktifkan di bawah:
# database.default.hostname = 127.0.0.1
# database.default.database = db_shopease
# database.default.username = root
# database.default.password =
# database.default.DBDriver = MySQLi
# database.default.port = 3306
